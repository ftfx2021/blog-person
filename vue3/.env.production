# 生产环境配置
NODE_ENV=production
VUE_APP_ENV=production

# API配置 - 关键修改使用相对路径
VUE_APP_BASE_API=/api
VUE_APP_BASE_URL=/

# 应用配置
VUE_APP_TITLE=个人博客
VUE_APP_DESCRIPTION=个人技术博客系统

# 生产配置
VUE_APP_MOCK=false
VUE_APP_DEBUG=false
VUE_APP_CONSOLE_LOG=false

# 文件上传配置 - 修改为相对路径
VUE_APP_UPLOAD_URL=/api/file/upload
VUE_APP_FILE_BASE_URL=/files/

# WebSocket配置 - 修改为使用域名
VUE_APP_WS_URL=ws://blog.miezzz.cn/ws

# 其他配置
VUE_APP_ROUTER_MODE=history
VUE_APP_PUBLIC_PATH=/

# CDN配置 - 可保留或修改
VUE_APP_CDN_URL=https://cdn.miezzz.cn/
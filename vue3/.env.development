# 开发环境配置
NODE_ENV=development
VUE_APP_ENV=development

# API配置
VUE_APP_BASE_API=http://localhost:1239/api
VUE_APP_BASE_URL=http://localhost:1239

# 应用配置
VUE_APP_TITLE=个人博客 - 开发环境
VUE_APP_DESCRIPTION=个人技术博客系统 - 开发环境

# 开发配置
VUE_APP_MOCK=false
VUE_APP_DEBUG=true
VUE_APP_CONSOLE_LOG=true

# 文件上传配置
VUE_APP_UPLOAD_URL=http://localhost:1239/api/file/upload
VUE_APP_FILE_BASE_URL=http://localhost:1239/files/

# WebSocket配置
VUE_APP_WS_URL=ws://localhost:1239/ws

# 前端服务配置
VUE_APP_FRONTEND_PORT=8888

# 其他配置
VUE_APP_ROUTER_MODE=history
VUE_APP_PUBLIC_PATH=/
# 测试环境配置
NODE_ENV=test
VUE_APP_ENV=test

# API配置
VUE_APP_BASE_API=http://localhost:8081/api
VUE_APP_BASE_URL=http://localhost:8081

# 应用配置
VUE_APP_TITLE=个人博客 - 测试环境
VUE_APP_DESCRIPTION=个人技术博客系统 - 测试环境

# 测试配置
VUE_APP_MOCK=false
VUE_APP_DEBUG=true
VUE_APP_CONSOLE_LOG=true

# 文件上传配置
VUE_APP_UPLOAD_URL=http://localhost:8081/api/file/upload
VUE_APP_FILE_BASE_URL=http://localhost:8081/files/

# WebSocket配置
VUE_APP_WS_URL=ws://localhost:8081/ws

# 前端服务配置
VUE_APP_FRONTEND_PORT=8888

# 其他配置
VUE_APP_ROUTER_MODE=history
VUE_APP_PUBLIC_PATH=/

{
  "name": "life-system",
  "version": "0.1.0",
  "private": true,
  "description": "人生系统桌面端",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run lint && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && npm run lint:boundaries && npm run lint:ipc",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:ipc": "node scripts/check-ipc-schemas.mjs",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "drizzle-orm": "^0.44.5",
    "element-plus": "^2.11.3",
    "mysql2": "^3.15.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.1"
  },
  "build": {
    "appId": "cn.life.system",
    "productName": "人生系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "migrations",
        "to": "migrations"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
